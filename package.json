{
  "name": "leek_mobile_android",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --lan",
    "start:clear": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --lan --clear",
    "start:tunnel": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --tunnel",
    "android": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --android --lan",
    "ios": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --ios --lan",
    "web": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --web",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build -p android --profile preview"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.105.4",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "cross-env": "^10.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
