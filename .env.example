# Copy to `.env` for local development (never commit real secrets to a public repo).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
EXPO_PUBLIC_STORAGE_BUCKET=product-images

# If `npx expo start` fails with "TypeError: fetch failed", Expo CLI cannot reach Expo's API
# (VPN, proxy, firewall, offline). Set this so `npx expo start --clear` works without npm scripts:
EXPO_NO_DEPENDENCY_VALIDATION=1
# Or use: npm run start:clear   (same flag + --clear + --lan)
# Broader offline: EXPO_OFFLINE=1

# Opening http://localhost:8082/ in Chrome only proves Metro works on THIS PC. Expo Go on your
# phone must use your PC's LAN IP (e.g. exp://192.168.1.9:8082), not localhost — set it below if
# the QR code still shows 127.0.0.1.
#
# Expo Go on a real phone cannot use exp://127.0.0.1. `npm start` uses --lan, but on Windows LAN
# detection can still fail → Metro falls back to 127.0.0.1. Then set your real Wi‑Fi IPv4:
#   Run: ipconfig  (use the IPv4 under "Wireless LAN adapter Wi‑Fi" or your active adapter)
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.42
# Phone + PC on same Wi‑Fi; allow Node.js through Windows Firewall. Guest Wi‑Fi isolation → use
# npm run start:tunnel instead.
